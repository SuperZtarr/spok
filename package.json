{
  "name": "spok",
  "version": "0.1.0",
  "private": true,
  "description": "Application modulaire multi-utilisateurs pour structurer, relier, évaluer et planifier",
  "scripts": {
    "dev:start": "powershell -ExecutionPolicy Bypass -File scripts/dev-start.ps1",
    "predev": "pnpm run build:packages",
    "dev": "concurrently --kill-others-on-fail --names api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @spok/api dev",
    "dev:web": "pnpm --filter @spok/web dev",
    "build:packages": "pnpm --filter @spok/shared --filter @spok/database build",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @spok/api build",
    "build:web": "pnpm --filter @spok/web build",
    "db:generate": "pnpm --filter @spok/database generate",
    "db:push": "pnpm --filter @spok/database push",
    "db:migrate": "pnpm --filter @spok/database migrate",
    "db:studio": "pnpm --filter @spok/database studio",
    "db:seed": "pnpm --filter @spok/database seed",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker-compose -f docker/docker-compose.dev.yml logs -f",
    "docker:dev:down": "docker-compose -f docker/docker-compose.dev.yml down",
    "docker:dev:restart": "docker-compose -f docker/docker-compose.dev.yml restart",
    "docker:prod": "docker-compose -f docker/docker-compose.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
