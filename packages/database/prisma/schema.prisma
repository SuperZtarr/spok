generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Configuration globale (clé-valeur JSON)
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// Menu unifié (vues d'espace + pages globales + admin + divers)
model MenuItem {
  id           String   @id @default(cuid())
  key          String   @unique           // identifiant technique (ex: "list", "home", "admin-users")
  label        String                     // texte affiché
  icon         String                     // nom icône Lucide
  section      String                     // groupe de menu (global, basic, planning, exploration, admin, misc)
  sectionLabel String                     // label affiché pour la section
  sectionOrder Int                        // tri des sections entre elles
  route        String?                    // route si navigation (/communities, /admin/users)
  viewMode     String?                    // viewMode si vue d'espace (list, kanban...)
  order        Int                        // tri dans la section
  visible      Boolean  @default(true)
  access       String   @default("user")  // "public" | "user" | "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("menu_items")
}

// Utilisateur
model User {
  id           String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  passwordHash  String
  name         String
  avatarUrl    String?
  globalRole        GlobalRole @default(USER)
  themePreference           String     @default("system")
  notificationPreferences   Json?      // { INVITATION: "all", ASSIGNMENT: "all", CONTRIBUTION: "in_app", MENTION: "all" }
  disabledAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships            SpaceMembership[]
  communityMemberships   CommunityMembership[]
  createdItems           Item[]  @relation("ItemCreatedBy")
  assignedItems          Item[]  @relation("ItemAssignedTo")
  contributions          Contribution[]
  auditLogs              AuditLog[]
  notifications              Notification[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  sentInvitations            Invitation[] @relation("InvitationInvitedBy")
  reactions                  Reaction[]
  sentCommunityEmails        CommunityEmail[]
  receivedCommunityEmails    CommunityEmailRecipient[]
  favoriteSpaces             SpaceFavorite[]
  bookmarkedItems            ItemBookmark[]

  @@map("users")
}

// Espace (personnel ou groupe)
model Space {
  id          String    @id @default(cuid())
  name        String
  type        SpaceType
  communityId String?
  avatarUrl   String?
  coverUrl      String?
  coverPosition  Int       @default(50)
  coverPositionX Int       @default(50)
  coverZoom      Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  // Hiérarchie d'espaces
  parentId  String?
  parent    Space?  @relation("SpaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Space[] @relation("SpaceHierarchy")

  defaultRole Role? // Auto-join role for new community members (null = no auto-join)
  visibility  SpaceVisibility? // null = inherit from parent space or community

  memberships SpaceMembership[]
  items       Item[]
  modules     SpaceModule[]
  tags        Tag[]
  auditLogs   AuditLog[]
  invitations Invitation[]
  favoritedBy SpaceFavorite[]

  @@index([communityId])
  @@index([parentId])
  @@map("spaces")
}

model SpaceFavorite {
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@map("space_favorites")
}

model ItemBookmark {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("item_bookmarks")
}

enum SpaceVisibility {
  OPEN     // Anyone (or all community members) can view and edit
  READONLY // Anyone (or all community members) can view, only explicit members can edit
  PRIVATE  // Only explicit members can access
}

enum SpaceType {
  PERSONAL
  GROUP
}

enum GlobalRole {
  USER
  ADMIN
}

// Communauté
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic      Boolean  @default(false)    // @deprecated — use visibility instead
  pendingPublic Boolean  @default(false)   // @deprecated — use pendingVisibility instead
  visibility         SpaceVisibility @default(PRIVATE)
  pendingVisibility  SpaceVisibility? // Requested visibility awaiting admin approval
  avatarUrl     String?
  coverUrl      String?
  coverPosition  Int       @default(50)
  coverPositionX Int       @default(50)
  coverZoom      Int       @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunityMembership[]
  spaces      Space[]
  tags        Tag[]
  invitations Invitation[]
  emails      CommunityEmail[]

  @@map("communities")
}

model CommunityEmail {
  id          String   @id @default(cuid())
  communityId String
  subject     String
  html        String
  sentById    String
  sentAt      DateTime @default(now())

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sentBy     User      @relation(fields: [sentById], references: [id])
  recipients CommunityEmailRecipient[]

  @@map("community_emails")
}

model CommunityEmailRecipient {
  id      String   @id @default(cuid())
  emailId String
  userId  String
  sentAt  DateTime @default(now())

  email CommunityEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id])

  @@unique([emailId, userId])
  @@map("community_email_recipients")
}

// Appartenance à une communauté
model CommunityMembership {
  id          String        @id @default(cuid())
  userId      String
  communityId String
  role        CommunityRole
  joinedAt    DateTime      @default(now())
  order       Int           @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_memberships")
}

enum CommunityRole {
  OWNER
  MEMBER
}

// Appartenance à un espace
model SpaceMembership {
  id       String   @id @default(cuid())
  userId   String
  spaceId  String
  role     Role
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@map("space_memberships")
}

enum Role {
  OWNER
  MEMBER
}

// Invitation à rejoindre une communauté ou un espace
model Invitation {
  id          String           @id @default(cuid())
  email       String
  token       String           @unique @default(uuid())
  status      InvitationStatus @default(PENDING)
  role        String           // Role or CommunityRole as string
  message     String?          // Optional message from inviter

  communityId String?
  spaceId     String?

  invitedById String
  invitedBy   User       @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  space       Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([communityId])
  @@index([spaceId])
  @@index([token])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Élément générique (note, projet, tâche)
model Item {
  id          String    @id @default(cuid())
  type        ItemType
  title       String
  description String?
  content     Json?
  url         String?
  status      String?
  priority    Int?
  position    Int       @default(0)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  spaceId     String
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User   @relation("ItemCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?  @relation("ItemAssignedTo", fields: [assignedToId], references: [id])

  // Relations hiérarchiques
  parentId String?
  parent   Item?   @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Item[]  @relation("ItemHierarchy")

  // Relations libres
  relationsFrom ItemRelation[] @relation("RelationFrom")
  relationsTo   ItemRelation[] @relation("RelationTo")

  tags ItemTag[]
  contributions Contribution[]
  reactions     Reaction[]
  bookmarkedBy  ItemBookmark[]

  @@index([spaceId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([parentId])
  @@map("items")
}

enum ItemType {
  NOTE
  PROJECT
  TASK
  MEETING
  PERIOD
  LINK
  CONFIG
  DOCUMENT
  IMAGE
  BUG
  DIAGRAM
}

// Relations entre éléments
model ItemRelation {
  id         String @id @default(cuid())
  fromItemId String
  toItemId   String
  type       String // "blocks", "relates", "depends", etc.
  label      String? // commentaire/note sur la relation

  fromItem Item @relation("RelationFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item @relation("RelationTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId, type])
  @@map("item_relations")
}

// Tags
model Tag {
  id          String  @id @default(cuid())
  name        String
  color       String?
  spaceId     String?
  communityId String?

  space     Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  items     ItemTag[]

  @@unique([spaceId, name])
  @@unique([communityId, name])
  @@index([communityId])
  @@map("tags")
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@map("item_tags")
}

// Modules activés par espace
model SpaceModule {
  id        String  @id @default(cuid())
  spaceId   String
  moduleKey String
  config    Json?
  enabled   Boolean @default(true)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, moduleKey])
  @@map("space_modules")
}

// Contributions aux éléments
model Contribution {
  id        String   @id @default(cuid())
  content   String
  itemId    String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Contribution?  @relation("ContributionThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  Contribution[] @relation("ContributionThread")
  reactions Reaction[]

  @@index([itemId])
  @@index([authorId])
  @@index([parentId])
  @@map("contributions")
}

// Traçabilité
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  spaceId   String?
  batchId   String?
  changes   Json?
  userId    String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([spaceId, createdAt])
  @@index([batchId])
  @@map("audit_logs")
}

// Notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  link      String?          // URL relative pour navigation (ex: /spaces/xxx)
  read      Boolean          @default(false)
  metadata  Json?            // données supplémentaires (actorName, spaceName, etc.)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  INVITATION
  ASSIGNMENT
  CONTRIBUTION
  MENTION
  EMAIL_VERIFICATION
}

// Refresh tokens for JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Réactions qualitatives sur items et contributions
model Reaction {
  id               String   @id @default(cuid())
  reactionType     String   // ex: "pertinent", "inexact", "inadapte", "j_adore", "trollage"
  userId           String
  itemId           String?
  contributionId   String?
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item         Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId], name: "unique_user_item_reaction")
  @@unique([userId, contributionId], name: "unique_user_contribution_reaction")
  @@index([itemId])
  @@index([contributionId])
  @@map("reactions")
}
