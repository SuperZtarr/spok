generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Utilisateur
model User {
  id           String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  passwordHash  String
  name         String
  avatarUrl    String?
  globalRole        GlobalRole @default(USER)
  themePreference   String     @default("system")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships            SpaceMembership[]
  communityMemberships   CommunityMembership[]
  createdItems           Item[]  @relation("ItemCreatedBy")
  assignedItems          Item[]  @relation("ItemAssignedTo")
  contributions          Contribution[]
  auditLogs              AuditLog[]
  notifications              Notification[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]

  @@map("users")
}

// Espace (personnel ou groupe)
model Space {
  id          String    @id @default(cuid())
  name        String
  type        SpaceType
  communityId String?
  avatarUrl   String?
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  // Hiérarchie d'espaces
  parentId  String?
  parent    Space?  @relation("SpaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Space[] @relation("SpaceHierarchy")

  defaultRole Role? // Auto-join role for new community members (null = no auto-join)

  memberships SpaceMembership[]
  items       Item[]
  modules     SpaceModule[]
  tags        Tag[]
  auditLogs   AuditLog[]

  @@index([communityId])
  @@index([parentId])
  @@map("spaces")
}

enum SpaceType {
  PERSONAL
  GROUP
}

enum GlobalRole {
  USER
  ADMIN
}

// Communauté
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  avatarUrl   String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunityMembership[]
  spaces      Space[]

  @@map("communities")
}

// Appartenance à une communauté
model CommunityMembership {
  id          String        @id @default(cuid())
  userId      String
  communityId String
  role        CommunityRole
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_memberships")
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

// Appartenance à un espace
model SpaceMembership {
  id       String   @id @default(cuid())
  userId   String
  spaceId  String
  role     Role
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@map("space_memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Élément générique (note, projet, tâche)
model Item {
  id          String    @id @default(cuid())
  type        ItemType
  title       String
  description String?
  content     Json?
  url         String?
  status      String?
  priority    Int?
  position    Int       @default(0)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  spaceId     String
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User   @relation("ItemCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?  @relation("ItemAssignedTo", fields: [assignedToId], references: [id])

  // Relations hiérarchiques
  parentId String?
  parent   Item?   @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Item[]  @relation("ItemHierarchy")

  // Relations libres
  relationsFrom ItemRelation[] @relation("RelationFrom")
  relationsTo   ItemRelation[] @relation("RelationTo")

  tags ItemTag[]
  contributions Contribution[]

  @@index([spaceId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([parentId])
  @@map("items")
}

enum ItemType {
  NOTE
  PROJECT
  TASK
  MEETING
  PERIOD
  LINK
  CONFIG
  DOCUMENT
  IMAGE
  BUG
}

// Relations entre éléments
model ItemRelation {
  id         String @id @default(cuid())
  fromItemId String
  toItemId   String
  type       String // "blocks", "relates", "depends", etc.
  label      String? // commentaire/note sur la relation

  fromItem Item @relation("RelationFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item @relation("RelationTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId, type])
  @@map("item_relations")
}

// Tags
model Tag {
  id      String  @id @default(cuid())
  name    String
  color   String?
  spaceId String

  space Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items ItemTag[]

  @@unique([spaceId, name])
  @@map("tags")
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@map("item_tags")
}

// Modules activés par espace
model SpaceModule {
  id        String  @id @default(cuid())
  spaceId   String
  moduleKey String
  config    Json?
  enabled   Boolean @default(true)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, moduleKey])
  @@map("space_modules")
}

// Contributions aux éléments
model Contribution {
  id        String   @id @default(cuid())
  content   String
  itemId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([authorId])
  @@map("contributions")
}

// Traçabilité
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  spaceId   String?
  batchId   String?
  changes   Json?
  userId    String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([spaceId, createdAt])
  @@index([batchId])
  @@map("audit_logs")
}

// Notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  link      String?          // URL relative pour navigation (ex: /spaces/xxx)
  read      Boolean          @default(false)
  metadata  Json?            // données supplémentaires (actorName, spaceName, etc.)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  INVITATION
  ASSIGNMENT
  CONTRIBUTION
  MENTION
}

// Refresh tokens for JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
