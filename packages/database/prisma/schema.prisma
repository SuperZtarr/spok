generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Configuration globale (clé-valeur JSON)
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}


// Utilisateur
model User {
  id           String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  passwordHash  String
  name         String
  avatarUrl    String?
  globalRole        GlobalRole @default(USER)
  themePreference           String     @default("system")
  notificationPreferences   Json?      // { INVITATION: "all", ASSIGNMENT: "all", CONTRIBUTION: "in_app", MENTION: "all" }
  disabledAt        DateTime?
  lastLoginAt       DateTime?
  // Accès MCP distant (jetons spok_pat_) : accordé par un admin, null = refusé (les admins globaux l'ont toujours).
  mcpAccessGrantedAt   DateTime?
  // Demande d'accès MCP en attente de décision admin (effacée à l'accord ou au retrait).
  mcpAccessRequestedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships            SpaceMembership[]
  communityMemberships   CommunityMembership[]
  createdItems           Item[]  @relation("ItemCreatedBy")
  assignedItems          Item[]  @relation("ItemAssignedTo")
  contributions          Contribution[]
  auditLogs              AuditLog[]
  notifications              Notification[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  sentInvitations            Invitation[] @relation("InvitationInvitedBy")
  reactions                  Reaction[]
  sentCommunityEmails        CommunityEmail[]
  receivedCommunityEmails    CommunityEmailRecipient[]
  favoriteSpaces             SpaceFavorite[]
  bookmarkedItems            ItemBookmark[]
  updatedItems               Item[]  @relation("ItemUpdatedBy")
  itemViews                  ItemView[]
  calendarFeeds              CalendarFeed[]
  dayPlanEntries             DayPlanEntry[]
  itemTemplates               ItemTemplate[]
  hostedLiveSessions          LiveSession[]      @relation("LiveSessionHost")
  liveSessionRoles            LiveSessionRole[]  @relation("LiveSessionRoles")
  liveSessionEntries          LiveSessionEntry[] @relation("LiveSessionEntries")
  liveSessionAgendaItems      LiveSessionAgendaItem[] @relation("LiveSessionAgendaPresenter")
  liveSessionInvites          LiveSessionInvite[]     @relation("LiveSessionInvitee")
  liveSessionInvitesBy        LiveSessionInvite[]     @relation("LiveSessionInviter")
  personalAccessTokens        PersonalAccessToken[]

  @@map("users")
}

// Espace (personnel ou groupe)
model Space {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        SpaceType
  communityId String?
  avatarUrl   String?
  coverUrl      String?
  coverPosition  Int       @default(50)
  coverPositionX Int       @default(50)
  coverZoom      Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  // Hiérarchie d'espaces
  parentId  String?
  parent    Space?  @relation("SpaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Space[] @relation("SpaceHierarchy")

  defaultRole Role? // Auto-join role for new community members (null = no auto-join)
  visibility  SpaceVisibility? // null = inherit from parent space or community
  defaultView String? // Default view mode when entering the space (list, kanban, mindmap...)
  position    Int     @default(0) // Ordre manuel parmi ses frères (même parent / même racine de communauté), puis nom

  memberships SpaceMembership[]
  items       Item[]
  processNodes ProcessNode[]
  processLanes ProcessLane[]
  tags        Tag[]
  auditLogs   AuditLog[]
  invitations Invitation[]
  favoritedBy SpaceFavorite[]
  liveSession       LiveSession?  @relation("LiveSessionSpace")
  childLiveSessions LiveSession[] @relation("LiveSessionParent")

  @@index([communityId])
  @@index([parentId])
  @@map("spaces")
}

model SpaceFavorite {
  userId    String
  spaceId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@map("space_favorites")
}

model ItemBookmark {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("item_bookmarks")
}

enum SpaceVisibility {
  OPEN     // Anyone (or all community members) can view and edit
  READONLY // Anyone (or all community members) can view, only explicit members can edit
  PRIVATE  // Only explicit members can access
}

// Contexte d'usage d'une communauté : dicte le mode d'interface dérivé
// (FORUM → vues discussion, PROJECT → outillage projet, JDR → jeu de rôle, null → neutre « tous »).
enum CommunityContext {
  FORUM
  PROJECT
  JDR
}

// Horizon temporel manuel d'un item sans échéance — dérive automatiquement de dueDate
// quand elle existe (voir packages/shared/src/utils/horizon.ts). null = bac à trier.
enum HorizonBucket {
  NOW    // Maintenant
  TODAY  // Aujourd'hui
  WEEK   // Cette semaine
  MONTH  // Ce mois
  LATER  // Plus tard — horizon de repos, ne remonte jamais automatiquement en revue
}

enum SpaceType {
  PERSONAL
  GROUP
}

enum GlobalRole {
  USER
  ADMIN
}

// Communauté
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Visibilité : seule source de vérité (isPublic/pendingPublic supprimés le 2026-10-16)
  visibility         SpaceVisibility @default(PRIVATE)
  pendingVisibility  SpaceVisibility? // Visibilité demandée, en attente de validation admin
  context       CommunityContext?    // Contexte d'usage (FORUM/PROJECT), null = neutre « tous »
  avatarUrl     String?
  coverUrl      String?
  coverPosition  Int       @default(50)
  coverPositionX Int       @default(50)
  coverZoom      Int       @default(100)
  referentiels   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunityMembership[]
  spaces      Space[]
  tags        Tag[]
  invitations Invitation[]
  emails      CommunityEmail[]

  @@map("communities")
}

model CommunityEmail {
  id          String   @id @default(cuid())
  communityId String
  subject     String
  html        String
  sentById    String
  sentAt      DateTime @default(now())

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sentBy     User      @relation(fields: [sentById], references: [id])
  recipients CommunityEmailRecipient[]

  @@map("community_emails")
}

model CommunityEmailRecipient {
  id      String   @id @default(cuid())
  emailId String
  userId  String
  sentAt  DateTime @default(now())

  email CommunityEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id])

  @@unique([emailId, userId])
  @@map("community_email_recipients")
}

// Appartenance à une communauté
model CommunityMembership {
  id          String        @id @default(cuid())
  userId      String
  communityId String
  role        CommunityRole
  joinedAt    DateTime      @default(now())
  order       Int           @default(0)
  muted       Boolean       @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_memberships")
}

enum CommunityRole {
  OWNER
  MEMBER
}

// Appartenance à un espace
model SpaceMembership {
  id          String   @id @default(cuid())
  userId      String
  spaceId     String
  role        Role
  joinedAt    DateTime @default(now())
  preferences Json?    // Préférences UI par vue (mindmap: collapsed, pinned, portals)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@map("space_memberships")
}

enum Role {
  OWNER
  MEMBER
}

// Invitation à rejoindre une communauté ou un espace
model Invitation {
  id          String           @id @default(cuid())
  email       String
  token       String           @unique @default(uuid())
  status      InvitationStatus @default(PENDING)
  role        String           // OWNER | MEMBER (valeurs communes à Role et CommunityRole, cf. routes/invitations.ts)
  message     String?          // Optional message from inviter

  communityId String?
  spaceId     String?

  invitedById String
  invitedBy   User       @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  space       Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([communityId])
  @@index([spaceId])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Élément générique (note, projet, tâche)
model Item {
  id          String    @id @default(cuid())
  type        ItemType
  title       String
  description String?
  content     Json?
  url         String?
  status      String?
  priority    Int?
  position    Int       @default(0)
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  manualHorizon HorizonBucket?
  horizonSetAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  spaceId     String
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User   @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?  @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  assignedToId String?
  assignedTo   User?  @relation("ItemAssignedTo", fields: [assignedToId], references: [id])
  // Accusé de lecture à l'assignation (2026-09-29) : date et auteur de l'assignation courante, posés par
  // l'API (utils/assignment.ts) à chaque changement d'assigné. null = non assigné ou assignation antérieure
  // à la fonctionnalité (pas d'indicateur). Pas de relation User : l'auteur n'est pas affiché.
  assignedAt   DateTime?
  assignedById String?

  // Copie de séance : lockedAt non null = contenu verrouillé (cf. apps/api/src/utils/itemLock.ts).
  // sourceItemId/sourceSpaceId : simple trace d'origine, pas de FK (la source peut disparaître).
  lockedAt      DateTime?
  sourceItemId  String?
  sourceSpaceId String?

  // Relations hiérarchiques
  parentId String?
  parent   Item?   @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Item[]  @relation("ItemHierarchy")

  // Relations libres
  relationsFrom ItemRelation[] @relation("RelationFrom")
  relationsTo   ItemRelation[] @relation("RelationTo")

  tags ItemTag[]
  contributions Contribution[]
  reactions     Reaction[]
  bookmarkedBy  ItemBookmark[]
  views         ItemView[]
  dayPlanEntries DayPlanEntry[]
  liveSessionEntries LiveSessionEntry[]
  processNodes  ProcessNode[]
  processLanes  ProcessLane[]

  @@index([spaceId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([parentId])
  @@index([sourceItemId])
  @@map("items")
}

// Position d'un item sur le canevas de la vue Process de son espace (2026-10-20).
// Une ligne = item placé ; absence de ligne = item « non placé ». Partagé entre membres.
model ProcessNode {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  // Couloir (2026-10-21) : null = item libre (x/y absolus) ; sinon x/y relatifs au couloir. Couloir supprimé → libre.
  laneId    String?
  lane      ProcessLane? @relation(fields: [laneId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@unique([spaceId, itemId])
  @@index([spaceId])
  @@index([laneId])
  @@map("process_nodes")
}

// Couloir (flux) de la vue Process (2026-10-21) : bande horizontale nommée par un item de l'espace, où l'on range
// visuellement des items (aucun effet sur parent/relations). position = ordre d'empilement, de haut en bas.
model ProcessLane {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  // Position libre (2026-10-21) : null = couloir empilé automatiquement (selon position) ; sinon posé à (x, y)
  x         Float?
  y         Float?
  createdAt DateTime @default(now())
  nodes     ProcessNode[]

  @@unique([spaceId, itemId])
  @@index([spaceId])
  @@map("process_lanes")
}

enum ItemType {
  UNDEFINED
  NOTE
  PROJECT
  TASK
  MEETING
  PERIOD
  LINK
  CONFIG
  DOCUMENT
  IMAGE
  BUG
  DIAGRAM
}

// Relations entre éléments
model ItemRelation {
  id         String @id @default(cuid())
  fromItemId String
  toItemId   String
  type       String // RELATION_TYPES de @spok/shared : blocks, relates, implements, drives (validé par l'API)
  label      String? // commentaire/note sur la relation

  fromItem Item @relation("RelationFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item @relation("RelationTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@unique([fromItemId, toItemId, type])
  @@map("item_relations")
}

// Tags
model Tag {
  id          String  @id @default(cuid())
  name        String
  color       String?
  spaceId     String?
  communityId String?

  space     Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  items     ItemTag[]

  @@unique([spaceId, name])
  @@unique([communityId, name])
  @@index([communityId])
  @@map("tags")
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@map("item_tags")
}

// Contributions aux éléments
model Contribution {
  id        String   @id @default(cuid())
  content   String
  itemId    String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item      Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Contribution?  @relation("ContributionThread", fields: [parentId], references: [id], onDelete: Cascade)
  children  Contribution[] @relation("ContributionThread")
  reactions Reaction[]

  @@index([itemId])
  @@index([authorId])
  @@index([parentId])
  @@map("contributions")
}

// Traçabilité
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  spaceId   String?
  batchId   String?
  changes   Json?
  userId    String
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  space Space? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([spaceId, createdAt])
  @@index([batchId])
  @@map("audit_logs")
}

// Notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  link      String?          // URL relative pour navigation (ex: /spaces/xxx)
  read      Boolean          @default(false)
  metadata  Json?            // données supplémentaires (actorName, spaceName, etc.)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  INVITATION
  ASSIGNMENT
  CONTRIBUTION
  MENTION
  EMAIL_VERIFICATION
  NEW_USER
  AUDIT_ALERT
  MCP_ACCESS_REQUEST
  MCP_ACCESS_DENIED
}

// Refresh tokens for JWT — userId sans FK (pas de cascade) : purge des expirés à l'émission
// (routes/auth.ts generateTokens) et purge explicite à la suppression d'un utilisateur.
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Suivi de lecture des items (pour le feed d'activité)
model ItemView {
  userId       String
  itemId       String
  viewedAt     DateTime @default(now()) @updatedAt
  // « Marquer comme non lu » : force l'item dans le feed /activity (hors fenêtre 60 j / auteur),
  // effacé à la prochaine consultation (POST /activity/items/:id/view)
  markedUnread Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("item_views")
}

// Réactions qualitatives sur items et contributions
model Reaction {
  id               String   @id @default(cuid())
  reactionType     String   // ex: "pertinent", "inexact", "inadapte", "j_adore", "trollage"
  userId           String
  itemId           String?
  contributionId   String?
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item         Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId], name: "unique_user_item_reaction")
  @@unique([userId, contributionId], name: "unique_user_contribution_reaction")
  @@index([itemId])
  @@index([contributionId])
  @@map("reactions")
}

// Abonnement ICS d'un utilisateur — calendriers externes de la page Ma journée.
// L'url est un lien ICS privé : secret utilisateur, ne jamais la loguer.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String
  name          String
  url           String
  color         String    @default("#3b82f6")
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("calendar_feeds")
}

// Jeton personnel d'accès API (MCP distant, 2026-10-12). Seul le hash SHA-256 est stocké ;
// tokenPrefix (12 premiers caractères) sert à l'affichage. scope : 'read' (GET/HEAD) ou 'write'.
// Révocation = revokedAt non null (jamais de suppression physique : traçabilité audit).
model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scope       String    @default("write")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

// Engagement du jour : tâche sélectionnée pour une date donnée (page Ma journée).
// L'état "fait" reste porté par Item.status — pas de deuxième vérité ici.
model DayPlanEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  itemId    String
  position  Int      @default(0)
  source    String   @default("manual") // 'auto' (suggestion acceptée) | 'manual' (pioche)
  plannedStart    DateTime? // début du bloc sur la grille du jour (brouillon perso — jamais les dates de l'item)
  plannedDuration Int?      // durée en minutes (15–720), null si non placé
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, date, itemId])
  @@index([userId, date])
  @@map("day_plan_entries")
}

// Modèle de structure d'items (titre+type, récursif) — capturé depuis un item existant,
// réutilisable pour créer d'un coup un item + toute son arborescence de sous-items dans
// n'importe quel espace existant. Portée globale (pas de spaceId/communityId) : partagé
// par tous les utilisateurs, pour le moment (2026-09-12).
model ItemTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Arbre récursif { title: string, type: ItemType, children: [...] } — un seul nœud racine.
  structure   Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("item_templates")
}

// Séance de présentation en direct — liée 1:1 à son espace dédié (sous-espace daté de parentSpaceId).
// controllerId : réservé au futur « passage de main » ; null = affichage libre (seul mode de l'étape 1).
// previousSessionId : séance dont celle-ci est la « suite » (une seule suite directe par séance, @unique).
model LiveSession {
  id             String            @id @default(cuid())
  spaceId        String            @unique
  parentSpaceId  String
  hostId         String
  status         LiveSessionStatus @default(PREPARED)
  controllerId   String?
  currentEntryId String?
  startedAt      DateTime          @default(now())
  liveAt         DateTime?
  endedAt        DateTime?
  previousSessionId String? @unique

  space       Space              @relation("LiveSessionSpace", fields: [spaceId], references: [id], onDelete: Cascade)
  parentSpace Space              @relation("LiveSessionParent", fields: [parentSpaceId], references: [id], onDelete: Cascade)
  host        User               @relation("LiveSessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  roles       LiveSessionRole[]
  entries     LiveSessionEntry[]
  agenda      LiveSessionAgendaItem[]
  invites     LiveSessionInvite[]
  previousSession LiveSession? @relation("LiveSessionSuite", fields: [previousSessionId], references: [id], onDelete: SetNull)
  nextSession     LiveSession? @relation("LiveSessionSuite")

  @@index([parentSpaceId])
  @@map("live_sessions")
}

enum LiveSessionStatus {
  PREPARED
  LIVE
  ENDED
}

// Rôle explicite dans une séance. Les participants n'ont pas de ligne (membres de l'espace de séance).
model LiveSessionRole {
  id        String              @id @default(cuid())
  sessionId String
  userId    String
  role      LiveSessionRoleType

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation("LiveSessionRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("live_session_roles")
}

enum LiveSessionRoleType {
  HOST
  PRESENTER
}

// Journal de séance : chronologie indépendante de l'organisation de l'espace (jamais réécrit).
// itemTitle : titre figé à l'affichage, survit à la suppression de la copie (itemId → null).
model LiveSessionEntry {
  id        String               @id @default(cuid())
  sessionId String
  kind      LiveSessionEntryKind
  userId    String
  itemId    String?
  itemTitle String?
  createdAt DateTime             @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation("LiveSessionEntries", fields: [userId], references: [id], onDelete: Cascade)
  item    Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("live_session_entries")
}

enum LiveSessionEntryKind {
  DISPLAY
  JOIN
}

// Ligne du programme d'une séance : lien vers un item source (aucune copie avant l'affichage).
// title : titre au moment de l'ajout (affichable même si la source devient inaccessible ou est supprimée).
model LiveSessionAgendaItem {
  id            String    @id @default(cuid())
  sessionId     String
  presenterId   String
  sourceItemId  String
  sourceSpaceId String
  title         String
  position      Int
  presentedAt   DateTime?
  createdAt     DateTime  @default(now())

  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  presenter User        @relation("LiveSessionAgendaPresenter", fields: [presenterId], references: [id], onDelete: Cascade)

  @@index([sessionId, position])
  @@map("live_session_agenda_items")
}

// Invitation à une séance d'un membre de la communauté SANS accès à l'espace parent : il devient membre
// de l'espace de séance (PRIVÉ) uniquement. Retirer l'invitation retire aussi cette adhésion.
model LiveSessionInvite {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  invitedById String
  // true si l'invitation a créé l'adhésion à l'espace de séance : seul ce cas est supprimé au retrait
  createdMembership Boolean @default(false)
  createdAt   DateTime @default(now())

  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation("LiveSessionInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User        @relation("LiveSessionInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("live_session_invites")
}
