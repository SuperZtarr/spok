# Dockerfile de développement pour l'API avec hot reload et debug
FROM node:20-slim

# Installer OpenSSL (requis par Prisma)
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Activer pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copier les fichiers de configuration pnpm (workspace complet)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/

# Forcer le hoisting pour éviter les symlinks pnpm (incompatibles avec Docker)
RUN echo "node-linker=hoisted" > .npmrc

# Installer les dépendances
RUN pnpm install

# Créer les symlinks workspace manuellement (hoisted mode ne les crée pas)
RUN mkdir -p node_modules/@spok && \
    ln -s /app/packages/database node_modules/@spok/database && \
    ln -s /app/packages/shared node_modules/@spok/shared && \
    ln -s /app/apps/api node_modules/@spok/api && \
    ln -s /app/apps/web node_modules/@spok/web

# Ajouter les binaires au PATH (tsc, prisma, tsx depuis node_modules/.bin)
ENV PATH="/app/node_modules/.bin:${PATH}"

# Copier les fichiers de configuration TypeScript
COPY tsconfig.base.json ./
COPY apps/api/tsconfig.json ./apps/api/
COPY packages/database/tsconfig.json ./packages/database/
COPY packages/shared/tsconfig.json ./packages/shared/

# Copier le code source (sera écrasé par les volumes en dev)
COPY apps/api ./apps/api
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared

# Générer le client Prisma
RUN PRISMA_GENERATE_SKIP_AUTOINSTALL=true prisma generate --schema=packages/database/prisma/schema.prisma

# Builder les packages partagés
RUN tsc --project packages/shared/tsconfig.json
RUN tsc --project packages/database/tsconfig.json

EXPOSE 3001

# Script de démarrage : push schema puis hot reload
# On lance tsx directement depuis le root node_modules/.bin pour éviter les shims pnpm
CMD ["sh", "-c", "prisma db push --schema=packages/database/prisma/schema.prisma && cd apps/api && tsx watch src/index.ts"]
