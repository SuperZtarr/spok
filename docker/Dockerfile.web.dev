# Dockerfile de développement pour le frontend avec hot reload (Vite HMR)
FROM node:20-alpine

# Activer pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copier les fichiers de configuration pnpm (workspace complet)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/

# Forcer le hoisting pour éviter les symlinks pnpm (incompatibles avec Docker)
RUN echo "node-linker=hoisted" > .npmrc

# Installer les dépendances
RUN pnpm install

# Créer les symlinks workspace manuellement (hoisted mode ne les crée pas)
RUN mkdir -p node_modules/@spok && \
    ln -s /app/packages/database node_modules/@spok/database && \
    ln -s /app/packages/shared node_modules/@spok/shared && \
    ln -s /app/apps/api node_modules/@spok/api && \
    ln -s /app/apps/web node_modules/@spok/web

# Ajouter les binaires pnpm au PATH (résout tsc, vite, etc.)
ENV PATH="/app/node_modules/.bin:${PATH}"

# Copier les fichiers de configuration TypeScript
COPY tsconfig.base.json ./
COPY apps/web/tsconfig.json ./apps/web/
COPY apps/web/tsconfig.node.json ./apps/web/
COPY apps/web/vite.config.ts ./apps/web/
COPY apps/web/tailwind.config.js ./apps/web/
COPY apps/web/postcss.config.js ./apps/web/
COPY packages/shared/tsconfig.json ./packages/shared/

# Copier le code source (sera écrasé par les volumes en dev)
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared

# Builder le package shared
RUN tsc --project packages/shared/tsconfig.json

EXPOSE 3000

# Démarrer Vite en mode développement avec HMR
# On lance vite directement depuis le root node_modules/.bin pour éviter les shims pnpm
CMD ["sh", "-c", "cd apps/web && vite --host 0.0.0.0"]
